# Your personal lab config (domain, AWS profile, email...) — generated
# locally by 'ocplab init' from a template in examples/, never meant to be
# committed.
#
# Anchored to the repository root on purpose. An unanchored pattern matches at
# any depth, so a shipped examples/cluster.yaml would have been excluded
# silently — present on the author's disk, missing for everyone who cloned.
/cluster.yaml

templates/install-config.yaml
install-dir/
archive/
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Generated by `ocplab render` from cluster.yaml — do not edit by hand
terraform/terraform.tfvars
ansible/inventory/group_vars/all/generated.yml

# Per-run Ansible execution logs written by `ocplab` — they contain live AWS
# identifiers and cluster internals, and are local history, not source.
logs/

__pycache__/
*.pyc
.venv/
