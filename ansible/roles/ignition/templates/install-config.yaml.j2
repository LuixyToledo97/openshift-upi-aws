apiVersion: v1
baseDomain: {{ ocplab_base_domain }}
metadata:
  name: {{ ocplab_cluster_name }}
compute:
- name: worker
  # Always 0 in UPI: Terraform creates the workers, not the installer.
  # Side effect: the masters stay schedulable (role master,worker).
  replicas: 0
controlPlane:
  name: master
  replicas: {{ ocplab_control_plane_replicas }}
{% if ocplab_capabilities_baseline %}
# Optional core components. Anything not enabled here is never deployed, so
# its images are never pulled — which is the point: image pulls cross the NAT
# gateway and are the single largest line on the bill (see README §8).
capabilities:
  baselineCapabilitySet: {{ ocplab_capabilities_baseline }}
{% if ocplab_capabilities_additional %}
  additionalEnabledCapabilities:
{% for capability in ocplab_capabilities_additional %}
  - {{ capability }}
{% endfor %}
{% endif %}
{% endif %}
networking:
  networkType: OVNKubernetes
  clusterNetwork:
  - cidr: {{ ocplab_cluster_network_cidr }}
    hostPrefix: 23
  serviceNetwork:
  - {{ ocplab_service_network_cidr }}
  machineNetwork:
  - cidr: {{ ocplab_vpc_cidr }}
platform:
  aws:
    region: {{ ocplab_aws_region }}
publish: External
pullSecret: {{ ignition_pull_secret_json }}
sshKey: {{ ignition_ssh_key_json }}
