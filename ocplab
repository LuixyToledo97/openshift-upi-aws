    False: EXAMPLES_DIR / "standard.yaml",
    True: EXAMPLES_DIR / "minimal.yaml",
}

GENERATED_HEADER = (
    "# GENERATED by `ocplab render` from cluster.yaml — DO NOT EDIT BY HAND.\n"
    "# Any change must be made in cluster.yaml, then re-run `ocplab render`.\n"
)

DNS_LABEL_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
DOMAIN_RE = re.compile(r"^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$")
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
ZONE_ID_RE = re.compile(r"^Z[A-Z0-9]+$")
# Pinned x.y.z only — deliberately not a channel like "stable-4.22". Every
# command re-renders, so a channel would be re-resolved on every invocation and
# could quietly move under a cluster mid-life; 'ocplab versions list' is how you
# find the concrete version to write here.
OCP_VERSION_RE = re.compile(r"^\d+\.\d+\.\d+$")

# Accepted by 'openshift-install explain installconfig.capabilities'.
CAPABILITY_BASELINES = (
    "None", "vCurrent",
    "v4.11", "v4.12", "v4.13", "v4.14", "v4.15", "v4.16", "v4.17", "v4.18",
)
# Refusing to disable these is the installer's rule, not ours — it reports:
#   "disabling CloudCredential capability available only for baremetal platforms"
#   "disabling CloudControllerManager is only supported on the Baremetal, None,
#    or External platform"
#   "the Ingress capability is required"
# Checked here as well so it surfaces at `ocplab validate` rather than several
# commands later, when ignition finally runs the installer.
CAPABILITIES_REQUIRED_ON_AWS = ("CloudCredential", "CloudControllerManager", "Ingress")

# Where managed binaries live, one immutable directory per version.
BIN_CACHE = Path("~/.ocplab/bin").expanduser()
# The binaries ocplab manages when openshift.version is set. kubectl ships in
# the same tarball as oc and is a symlink to it, so it comes along for free.
MANAGED_BINARIES = ("openshift-install", "oc", "kubectl")
# What `ocplab init` writes for a value the user can't know yet — see
# validate_cluster_config's zone_id_optional.
ZONE_ID_PLACEHOLDER = "CHANGEME"



