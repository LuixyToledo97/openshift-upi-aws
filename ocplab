def cmd_power(args):
    load_and_validate(args.config)
    action = args.action
    confirm_msg = None
    if action == "off":
        confirm_msg = (
            "This gracefully shuts down the whole cluster (cordon, drain workers, "
            "in-guest shutdown workers then masters) as an alternative to 'ocplab "
            "destroy'. Note: stopped EC2 instances still bill for their EBS volumes — "
            "leaving the cluster stopped costs MORE over time than destroying it and "
            "redeploying later. Continue?"
        )
    elif action == "on":
        confirm_msg = (
            "This powers the cluster back up (masters, then workers, approving CSRs "
            "and verifying health along the way). Expect ~10-15 minutes. Continue?"
        )
    # 'status' is read-only (just describes EC2 instance states) — no confirmation needed.
    run_ansible_playbook("power", args, extra_vars={"ocplab_power_action": action}, confirm_msg=confirm_msg)


