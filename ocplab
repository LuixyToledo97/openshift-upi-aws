def log_path_for(args):
    """logs/<timestamp>_<command>[-<action>][-dry-run].log

    Named after what was run and when, so a directory listing answers "which
    run was that?" without opening anything. Colons are avoided on purpose —
    ISO-8601's time separator is legal on Linux but hostile on other
    filesystems and awkward to type in a shell.
    """
    parts = [args.command]
    action = getattr(args, "action", None)
    if action:
        parts.append(str(action))
    if getattr(args, "dry_run", False):
        parts.append("dry-run")
    return LOGS_DIR / f"{time.strftime('%Y-%m-%d_%H%M%S')}_{'-'.join(parts)}.log"


def display_path(path):
    """Repo-relative when possible — shorter, and copy-pasteable from the repo."""
    try:
        return str(path.relative_to(Path.cwd()))
    except ValueError:
        return str(path)


def run_ansible_playbook(playbook_name, args, *, extra_vars=None, confirm_msg=None,
                         zone_id_optional=False, render=True, exit_after=True):
    playbook = PLAYBOOKS_DIR / f"{playbook_name}.yml"
    if not playbook.exists():
        die(
            f"'ansible/playbooks/{playbook_name}.yml' doesn't exist yet. "
            "This command is on the roadmap but not implemented yet "
            "— see the checklist in CLAUDE.md.",
            code=2,
        )

    if confirm_msg and not args.yes:
        resp = input(f"{confirm_msg} [y/N] ").strip().lower()
        if resp not in ("y", "yes"):
            print("Cancelled.")
            sys.exit(0)

    # EVERY playbook-backed command renders first, without exception. The roles
    # read generated.yml, never cluster.yaml directly, so any command that skips
    # this silently runs against whatever the *last* render happened to write —
    # a different config, a since-edited value, or a placeholder. This was fixed
    # twice before as a one-off (deploy, then bootstrap) and regressed anyway in
    # preflight/verify/cost/power/destroy/safety-net/ignition, so it now lives in
    # the single funnel all of them go through rather than in each caller.
    # Deliberately after the confirmation prompt: a cancelled run shouldn't
    # leave regenerated files behind.
    #
    # render=False is for commands that don't operate on the cluster at all.
    # 'versions' is the case: rendering would auto-discover the RHCOS AMI from
    # an installer binary that, by definition, may not be downloaded yet — and
    # would refuse to run for exactly the reason you invoked it. Those commands
    # pass what little they need from cluster.yaml as extra vars instead.
    if render:
        cmd_render(args, zone_id_optional=zone_id_optional, honor_dry_run=False)

    cmd = ["ansible-playbook", str(playbook)]
    if args.tags:
        cmd += ["--tags", args.tags]
    if args.dry_run:
        cmd += ["--check", "--diff"]
    if args.verbose:
        cmd.append("-" + "v" * args.verbose)

    ev = {"ocplab_config_path": str(args.config.resolve())}
    if extra_vars:
        ev.update(extra_vars)
    cmd += ["--extra-vars", json.dumps(ev)]

    env = os.environ.copy()
    log_path = log_path_for(args)
    try:
        LOGS_DIR.mkdir(exist_ok=True)
    except OSError as exc:
        print(f"warning: couldn't create {LOGS_DIR} ({exc.strerror}) — running without a log.",
              file=sys.stderr)
        log_path = None

    if log_path is not None:
        if args.verbose:
            # -v is the escape hatch back to raw Ansible, so the ocplab callback
            # isn't loaded and can't write the log itself. Ansible's own
            # log_path covers the run instead — one writer either way, never two.
            env["ANSIBLE_STDOUT_CALLBACK"] = "default"
            env["ANSIBLE_LOG_PATH"] = str(log_path)
        else:
            env["OCPLAB_LOG_FILE"] = str(log_path)
        # flush: this must land before ansible-playbook's own output, and
        # ocplab's stdout is block-buffered whenever it isn't a terminal
        # (piped to tee, redirected to a file) — without an explicit flush the
        # line surfaces at exit instead, pointing at a log the run already finished.
        print(f"Log: {display_path(log_path)}", flush=True)

    try:
        result = subprocess.run(cmd, cwd=ANSIBLE_DIR, env=env)
    except OSError as exc:
        die(
            f"couldn't run 'ansible-playbook' ({exc.strerror}). "
            "Activate the project venv with 'source .venv/bin/activate' — that puts "
            "the right ansible-playbook first on the PATH, ahead of "
            "any other one that might be around (e.g. from another project or an "
            "editor extension). If it's already activated, check "
            "'which -a ansible-playbook' to see what's resolving first."
        )

    if result.returncode != 0:
        # The callback has already explained *what* failed; this adds where to
        # read the rest. Printed here rather than in the callback so it still
        # appears when the callback never ran at all (a playbook syntax error,
        # an unparseable inventory), which is exactly when it's needed most.
        print(f"\nocplab {args.command} failed (exit {result.returncode}).", file=sys.stderr)
        if log_path is not None and log_path.exists():
            print(f"Full log of this run: {display_path(log_path)}", file=sys.stderr)
        if not args.verbose:
            print("Re-run with -v for raw Ansible output.", file=sys.stderr)
    # exit_after=False lets a caller do something once the playbook is done —
    # 'versions' relinks .venv/bin, which can only happen after a download has
    # actually produced the binaries.
    if not exit_after:
        return result.returncode
    sys.exit(result.returncode)


