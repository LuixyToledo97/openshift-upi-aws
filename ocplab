class ConfigError(Exception):
    """cluster.yaml validation error — message already ready to display."""


# --------------------------------------------------------------------------
# utilities
# --------------------------------------------------------------------------

def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def dig(data, *keys):
    """Walk a nested dict; returns None if any link in the chain is missing."""
    cur = data
    for key in keys:
        if not isinstance(cur, dict) or key not in cur:
            return None
        cur = cur[key]
    return cur


# --------------------------------------------------------------------------
# load and validate cluster.yaml
# --------------------------------------------------------------------------

def load_cluster_config(path):
    if not path.exists():
        raise ConfigError(
            f"{path} does not exist. Generate a template with 'ocplab init -f {path}'."
        )
    try:
        with path.open() as fh:
            data = yaml.safe_load(fh)
    except yaml.YAMLError as exc:
        raise ConfigError(f"{path} is not valid YAML: {exc}")
    if not isinstance(data, dict):
        raise ConfigError(f"{path} is empty or is not a YAML mapping")
    return data


def validate_cidr(errors, field, value, *, expect_prefix=None):
    if value is None:
        errors.append(f"missing '{field}'")
        return None
    try:
        network = ipaddress.ip_network(value, strict=True)
    except ValueError as exc:
        errors.append(f"'{field}' ({value!r}) is not a valid CIDR: {exc}")
        return None
    return network


def validate_cluster_config(cfg, config_path, *, zone_id_optional=False):
    """Returns the list of errors found (empty if everything is correct)."""
    errors = []

    if dig(cfg, "apiVersion") != "ocplab/v1":
        errors.append("'apiVersion' must be 'ocplab/v1'")
    if dig(cfg, "kind") != "ClusterConfig":
        errors.append("'kind' must be 'ClusterConfig'")

    name = dig(cfg, "metadata", "name")
    if not name:
        errors.append("missing 'metadata.name'")
    elif not DNS_LABEL_RE.match(name):
        errors.append(
            f"'metadata.name' ({name!r}) must be a valid DNS label "
            "(lowercase letters, digits, and hyphens, not starting/ending with a hyphen)"
        )

    base_domain = dig(cfg, "metadata", "baseDomain")
    if not base_domain:
        errors.append("missing 'metadata.baseDomain'")
    elif not DOMAIN_RE.match(base_domain):
        errors.append(f"'metadata.baseDomain' ({base_domain!r}) doesn't look like a valid domain")

    region = dig(cfg, "platform", "aws", "region")
    if not region:
        errors.append("missing 'platform.aws.region'")

    az = dig(cfg, "platform", "aws", "availabilityZone")
    if not az:
        errors.append("missing 'platform.aws.availabilityZone'")
    elif region and not az.startswith(region):
        errors.append(
            f"'platform.aws.availabilityZone' ({az!r}) doesn't belong to region "
            f"'platform.aws.region' ({region!r})"
        )

    if not dig(cfg, "platform", "aws", "profile"):
        errors.append("missing 'platform.aws.profile' (profile from ~/.aws/credentials)")

    zone_id = dig(cfg, "platform", "aws", "publicHostedZoneId")
    if zone_id_optional and (not zone_id or zone_id == ZONE_ID_PLACEHOLDER):
        # 'ocplab bootstrap' is the command that CREATES the public hosted
        # zone, so demanding its ID up front is a chicken-and-egg that blocks
        # every first-time run. The bootstrap role finds/creates the zone by
        # DOMAIN NAME and reads the real ID back from AWS — it never consumes
        # this field, it only reports when cluster.yaml disagrees with reality.
        # Every other command validates it strictly, so a config left on the
        # placeholder still can't reach terraform.
        pass
    elif not zone_id:
        errors.append("missing 'platform.aws.publicHostedZoneId'")
    elif zone_id == ZONE_ID_PLACEHOLDER:
        errors.append(
            f"'platform.aws.publicHostedZoneId' is still the {ZONE_ID_PLACEHOLDER} placeholder — "
            "run 'ocplab bootstrap apply' first: it creates the public hosted zone and "
            "prints the ID to paste here."
        )
    elif not ZONE_ID_RE.match(zone_id):
        errors.append(f"'platform.aws.publicHostedZoneId' ({zone_id!r}) doesn't look like a valid Zone ID")

    vpc_net = validate_cidr(errors, "networking.vpcCidr", dig(cfg, "networking", "vpcCidr"))
    public_net = validate_cidr(errors, "networking.publicSubnetCidr", dig(cfg, "networking", "publicSubnetCidr"))
    private_net = validate_cidr(errors, "networking.privateSubnetCidr", dig(cfg, "networking", "privateSubnetCidr"))
    validate_cidr(errors, "networking.clusterNetwork", dig(cfg, "networking", "clusterNetwork"))
    validate_cidr(errors, "networking.serviceNetwork", dig(cfg, "networking", "serviceNetwork"))

    if vpc_net and public_net and not public_net.subnet_of(vpc_net):
        errors.append("'networking.publicSubnetCidr' is not contained within 'networking.vpcCidr'")
    if vpc_net and private_net and not private_net.subnet_of(vpc_net):
        errors.append("'networking.privateSubnetCidr' is not contained within 'networking.vpcCidr'")
    if public_net and private_net and public_net.overlaps(private_net):
        errors.append("'networking.publicSubnetCidr' and 'networking.privateSubnetCidr' overlap")

    cp_replicas = dig(cfg, "controlPlane", "replicas")
    if not isinstance(cp_replicas, int) or cp_replicas < 1:
        errors.append("'controlPlane.replicas' must be an integer >= 1")
    elif cp_replicas % 2 == 0:
        errors.append(
            f"'controlPlane.replicas' ({cp_replicas}) is even — etcd needs an odd "
            "number of members to form quorum"
        )
    if not dig(cfg, "controlPlane", "instanceType"):
        errors.append("missing 'controlPlane.instanceType'")

    comp_replicas = dig(cfg, "compute", "replicas")
    if not isinstance(comp_replicas, int) or comp_replicas < 0:
        errors.append("'compute.replicas' must be an integer >= 0")
    if not dig(cfg, "compute", "instanceType"):
        errors.append("missing 'compute.instanceType'")

    if not dig(cfg, "bootstrap", "instanceType"):
        errors.append("missing 'bootstrap.instanceType'")

    for group in ("compute", "bootstrap"):
        spot = dig(cfg, group, "spot")
        if spot is not None and not isinstance(spot, bool):
            errors.append(f"'{group}.spot' must be true or false, not {spot!r}")

    # Rejected rather than merely discouraged. A reclaimed master cannot be
    # replaced automatically in UPI — there is no ControlPlaneMachineSet and no
    # Machine API for manually provisioned machines — so recovery means editing
    # etcd membership by hand on a cluster that is already degraded. That isn't
    # a trade-off worth offering for a few cents an hour, and it would only be
    # discovered the day AWS reclaims capacity.
    if dig(cfg, "controlPlane", "spot"):
        errors.append(
            "'controlPlane.spot' is not supported: in UPI a reclaimed master is not "
            "replaced automatically (no ControlPlaneMachineSet), and recovering one "
            "means repairing etcd membership by hand. Use 'compute.spot' and "
            "'bootstrap.spot' instead — those are recoverable with 'ocplab deploy'."
        )

    pull_secret_file = dig(cfg, "credentials", "pullSecretFile")
    if not pull_secret_file:
        errors.append("missing 'credentials.pullSecretFile'")
    else:
        p = Path(pull_secret_file).expanduser()
        if not p.exists():
            errors.append(f"'credentials.pullSecretFile' ({p}) does not exist")
        else:
            try:
                parsed = json.loads(p.read_text())
                if "auths" not in parsed:
                    errors.append(f"{p} doesn't look like a pull secret (missing the 'auths' key)")
            except json.JSONDecodeError as exc:
                errors.append(f"{p} is not valid JSON: {exc}")

    ssh_key_file = dig(cfg, "credentials", "sshPublicKeyFile")
    if not ssh_key_file:
        errors.append("missing 'credentials.sshPublicKeyFile'")
    else:
        # Unlike pullSecretFile, this one doesn't have to exist yet:
        # 'ocplab bootstrap' generates it when missing (ssh_key.yml). Only
        # validate its content if it's already there.
        p = Path(ssh_key_file).expanduser()
        if p.exists() and not p.read_text().startswith("ssh-"):
            errors.append(f"{p} doesn't look like an SSH public key (doesn't start with 'ssh-')")

    # Custom TLS certs (API / *.apps) are optional and independent as two
    # pairs — bring your own REAL, CA-signed cert/key files (never
    # self-signed, see cluster.yaml). No existence check here: you might
    # set these paths in cluster.yaml before actually placing the files.
    certs = dig(cfg, "certificates") or {}
    if bool(certs.get("apiCertFile")) != bool(certs.get("apiKeyFile")):
        errors.append(
            "'certificates.apiCertFile' and 'certificates.apiKeyFile' must be set together (or neither)"
        )
    if bool(certs.get("appsCertFile")) != bool(certs.get("appsKeyFile")):
        errors.append(
            "'certificates.appsCertFile' and 'certificates.appsKeyFile' must be set together (or neither)"
        )

    version = dig(cfg, "openshift", "version")
    if version is not None and not OCP_VERSION_RE.match(str(version)):
        errors.append(
            f"'openshift.version' ({version!r}) must be an exact x.y.z version such as "
            "'4.22.6', not a channel — run 'ocplab versions list' to see what's available"
        )

    caps = dig(cfg, "openshift", "capabilities") or {}
    baseline = caps.get("baselineCapabilitySet")
    additional = caps.get("additionalEnabledCapabilities") or []
    if baseline is not None and baseline not in CAPABILITY_BASELINES:
        errors.append(
            f"'openshift.capabilities.baselineCapabilitySet' ({baseline!r}) must be one of: "
            + ", ".join(CAPABILITY_BASELINES)
        )
    if not isinstance(additional, list):
        errors.append("'openshift.capabilities.additionalEnabledCapabilities' must be a list")
    elif baseline == "None":
        missing = [c for c in CAPABILITIES_REQUIRED_ON_AWS if c not in additional]
        if missing:
            errors.append(
                "'openshift.capabilities.additionalEnabledCapabilities' is missing "
                + ", ".join(missing)
                + " — the installer refuses to disable these on AWS. Add them, or drop "
                "baselineCapabilitySet to keep the default set."
            )

    safety = dig(cfg, "safetyNet") or {}
    if safety.get("enabled"):
        budget = safety.get("budgetUsd")
        if not isinstance(budget, (int, float)) or budget <= 0:
            errors.append("'safetyNet.budgetUsd' must be a number > 0 when safetyNet is enabled")
        emails = safety.get("alertEmails") or []
        if not emails:
            errors.append("'safetyNet.alertEmails' cannot be empty when safetyNet is enabled")
        for email in emails:
            if not EMAIL_RE.match(email):
                errors.append(f"'safetyNet.alertEmails' contains an invalid email: {email!r}")
        killswitch = safety.get("killswitch") or {}
        if killswitch.get("enabled"):
            if not killswitch.get("schedule"):
                errors.append("missing 'safetyNet.killswitch.schedule' with killswitch enabled")
            if not killswitch.get("timezone"):
                errors.append("missing 'safetyNet.killswitch.timezone' with killswitch enabled")

    return errors


def load_and_validate(config_path, *, zone_id_optional=False):
    cfg = load_cluster_config(config_path)
    errors = validate_cluster_config(cfg, config_path, zone_id_optional=zone_id_optional)
    if errors:
        print(f"{config_path}: {len(errors)} validation error(s):\n", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        sys.exit(1)
    return cfg


# --------------------------------------------------------------------------
# render: cluster.yaml -> terraform.tfvars + inventory/group_vars/all/generated.yml
# --------------------------------------------------------------------------

def discover_rhcos_ami(region, installer="openshift-install"):
    """Auto-discover the RHCOS AMI for `region` via 'openshift-install
    coreos print-stream-json'. Local only — the stream metadata is embedded
    in the binary, no AWS or network calls needed.

    Taking the installer path as an argument is what ties the node image to the
    declared version: pin openshift.version and the AMI follows from that same
    binary, automatically and consistently."""
    try:
        result = subprocess.run(
            [installer, "coreos", "print-stream-json"],
            capture_output=True, text=True, check=True,
        )
    except FileNotFoundError:
        raise ConfigError(
            "'openshift-install' not found on PATH — needed to auto-discover the RHCOS AMI "
            "since 'openshift.rhcosAmi' isn't set in cluster.yaml. Install it (see README "
            "§2.1) or set 'openshift.rhcosAmi' manually."
        )
    except subprocess.CalledProcessError as exc:
        raise ConfigError(
            f"'openshift-install coreos print-stream-json' failed: {exc.stderr.strip()}"
        )
    try:
        stream = json.loads(result.stdout)
        return stream["architectures"]["x86_64"]["images"]["aws"]["regions"][region]["image"]
    except (json.JSONDecodeError, KeyError) as exc:
        raise ConfigError(
            f"couldn't find an RHCOS AMI for region {region!r} in the output of "
            f"'openshift-install coreos print-stream-json' ({exc}). Set "
            "'openshift.rhcosAmi' manually in cluster.yaml."
        )


def managed_bin_dir(version):
    return BIN_CACHE / str(version)


def dry_run_for(args, honor_dry_run):
    return args.dry_run and honor_dry_run


def link_managed_binaries(version):
    """Point .venv/bin/{oc,kubectl,openshift-install} at the declared version.

    This is purely for the human's shell — `oc get co` typed by hand. ocplab
    itself always uses absolute versioned paths and never these links.

    .venv/bin is the target because it is already on the PATH whenever ocplab
    is usable at all (every command that calls Ansible needs the venv
    activated), so `oc` just works with no extra setup. It's also per-checkout,
    which keeps two clones with different versions from fighting over one
    link — the reason an earlier design put a shared 'current' symlink under
    ~/.ocplab and then needed a second level of indirection to make it safe.

    Repointed on every render, which runs before every command, so it cannot
    drift from cluster.yaml for longer than one invocation.
    """
    venv_bin = REPO_ROOT / ".venv" / "bin"
    if not venv_bin.is_dir():
        return []  # no venv yet (e.g. plain `ocplab render`); nothing to link into
    bindir = managed_bin_dir(version)
    changed = []
    for name in MANAGED_BINARIES:
        target, link = bindir / name, venv_bin / name
        if not target.exists():
            continue
        try:
            # Only ever replace a symlink. A real file here would be something
            # the user or pip put there, and silently deleting it would be rude.
            if link.is_symlink():
                if link.resolve() == target.resolve():
                    continue
                link.unlink()
            elif link.exists():
                continue
            link.symlink_to(target)
            changed.append(name)
        except OSError:
            pass  # a broken convenience link must never fail a deploy
    return changed


def sync_managed_binaries(cfg):
    """Make .venv/bin match what cluster.yaml declares, either way.

    Called from every command that reads the config and is allowed to touch
    disk — render, status, versions. It used to live only in render, on the
    reasoning that render runs before every command; that was wrong. 'status'
    is local and never renders, and 'versions' deliberately skips rendering
    (rendering needs the binary it may be about to download), so pinning a
    version and then running exactly those two — the natural thing to do —
    left `oc` pointing at the old binary while `status` reported the new
    version as active.
    """
    version = dig(cfg, "openshift", "version")
    if version and (managed_bin_dir(version) / "oc").exists():
        changed = link_managed_binaries(version)
        if changed:
            # Said only when something actually moved. Printing it on every
            # command would make it wallpaper, and it matters exactly once:
            # the moment the version behind `oc` changes under a running shell.
            print(
                f"Linked {', '.join(changed)} to OpenShift {version} in .venv/bin.\n"
                "  If 'oc version' still reports another version, run 'hash -r' — your "
                "shell remembers where a command lived the first time you ran it."
            )
    elif not version:
        removed = unlink_managed_binaries()
        if removed:
            print(
                f"Removed the managed {', '.join(removed)} link(s) — back to whatever is "
                "on your PATH.\n  Run 'hash -r' if a shell still reports the managed version."
            )


def unlink_managed_binaries():
    """Remove the convenience links, but only ours.

    'Ours' means a symlink pointing inside the binary cache. Anything else in
    .venv/bin — a real file, or a link the user made themselves — is left
    alone: this function exists to undo link_managed_binaries, not to police
    the directory.
    """
    venv_bin = REPO_ROOT / ".venv" / "bin"
    removed = []
    for name in MANAGED_BINARIES:
        link = venv_bin / name
        try:
            if link.is_symlink() and BIN_CACHE in link.resolve().parents:
                link.unlink()
                removed.append(name)
        except OSError:
            pass
    return removed


_KUBECONFIG_HOOK_START = "# >>> ocplab kubeconfig >>>"
_KUBECONFIG_HOOK_END = "# <<< ocplab kubeconfig <<<"


def kubeconfig_hook_block():
    """The block 'ocplab setup' appends to .venv/bin/activate.

    Pinning the binary was only half the problem: `oc` in an ocplab shell was
    already ours (see link_managed_binaries), but where it pointed was still
    whatever ~/.kube/config had as its current context. That is the more
    dangerous half — the failure isn't 'cluster not found', it's talking to a
    *different* cluster in silence, which is how a hand-typed `oc delete` ends
    up somewhere it was never meant to go.

    Two deliberate constraints:

    - It only sets KUBECONFIG when the caller hasn't. An explicit value is
      always the user's, never ours to override.
    - It exports the path whether or not install-dir exists yet. A shell that
      activated before the first deploy would otherwise silently fall back to
      the very context this exists to avoid; pointing at a not-yet-created
      kubeconfig fails loudly instead, which is the safe direction.

    Restoring on deactivate needs the venv's own function renamed, so that part
    is bash/zsh only and entirely optional: if it doesn't take, KUBECONFIG
    outlives the deactivate and nothing else changes. The export itself cannot
    fail, which keeps a broken hook from ever breaking activation.
    """
    return f"""
{_KUBECONFIG_HOOK_START}
# Added by 'ocplab setup'. Points oc/kubectl at THIS cluster while the venv is
# active, so a hand-typed command can't land on whatever context ~/.kube/config
# happens to have. Delete this block to opt out; 'ocplab env' does the same
# thing on demand.
# The marker is what makes re-sourcing activate safe. The second pass redefines
# deactivate from scratch, destroying the wrapper below, and would then skip
# this block entirely because KUBECONFIG is already set — leaving it exported
# with nothing left to undo it. 'we set it' has to count as 'not set'.
if [ -z "${{KUBECONFIG:-}}" ] || [ -n "${{_OCPLAB_KUBECONFIG:-}}" ]; then
    _OCPLAB_KUBECONFIG=1
    export KUBECONFIG="{KUBECONFIG_PATH}"
    if [ -n "${{BASH_VERSION:-}}${{ZSH_VERSION:-}}" ]; then
        # Rename the venv's own deactivate and wrap it, so leaving the venv also
        # leaves the cluster. The sed rewrites only the name on the first line,
        # which keeps each shell's own brace layout intact.
        eval "$(typeset -f deactivate | sed '1s/deactivate/_ocplab_venv_deactivate/')" 2>/dev/null
        if typeset -f _ocplab_venv_deactivate >/dev/null 2>&1; then
            deactivate() {{
                unset KUBECONFIG
                unset _OCPLAB_KUBECONFIG
                _ocplab_venv_deactivate "$@"
            }}
        fi
    fi
fi
{_KUBECONFIG_HOOK_END}
"""


def install_kubeconfig_hook():
    """Add (or refresh) the KUBECONFIG block in .venv/bin/activate.

    Rewritten rather than appended-to when already present, so a checkout that
    moves — or a hook from an older version — converges instead of accumulating
    blocks. Best-effort: `setup` has already done the part that matters by the
    time this runs, and failing to write a convenience hook must not fail it.
    """
    activate = REPO_ROOT / ".venv" / "bin" / "activate"
    if not activate.is_file():
        return None
    try:
        current = activate.read_text()
        if _KUBECONFIG_HOOK_START in current and _KUBECONFIG_HOOK_END in current:
            head = current[: current.index(_KUBECONFIG_HOOK_START)].rstrip("\n")
            tail = current[current.index(_KUBECONFIG_HOOK_END) + len(_KUBECONFIG_HOOK_END):]
            updated = head + "\n\n" + kubeconfig_hook_block().strip("\n") + "\n" + tail.lstrip("\n")
        else:
            updated = current.rstrip("\n") + "\n" + kubeconfig_hook_block()
        if updated != current:
            activate.write_text(updated)
        return activate
    except OSError:
        return None


def resolve_binaries(cfg):
    """Absolute paths to openshift-install and oc, or the bare names.

    When 'openshift.version' is set, everything resolves inside that version's
    cache directory — by absolute path, never through a symlink, so repointing
    the version can't swap a binary out from under a running deploy. When it
    isn't set, the bare names are returned and the PATH decides, exactly as
    before this existed: declaring a version is opt-in, and omitting it must
    keep working for anyone who installed the binaries by hand.
    """
    version = dig(cfg, "openshift", "version")
    if not version:
        return {name: name for name in MANAGED_BINARIES}
    bindir = managed_bin_dir(version)
    return {name: str(bindir / name) for name in MANAGED_BINARIES}


def cached_versions():
    """Versions present in the local cache, newest first, with their size."""
    if not BIN_CACHE.is_dir():
        return []
    found = []
    for entry in BIN_CACHE.iterdir():
        if not entry.is_dir() or not OCP_VERSION_RE.match(entry.name):
            continue
        # oc and kubectl are hardlinks to one inode, so summing file sizes
        # naively reports ~130 MB more than the directory actually occupies.
        # Count each inode once, the way du does.
        seen, size = set(), 0
        for f in entry.rglob("*"):
            if not f.is_file():
                continue
            stat = f.stat()
            if stat.st_ino in seen:
                continue
            seen.add(stat.st_ino)
            size += stat.st_size
        found.append({"version": entry.name, "path": entry, "size": size})
    return sorted(found, key=lambda v: version_key(v["version"]), reverse=True)


def version_key(version):
    """Sort 4.22.6 above 4.9.1 — string order would put 4.9 last."""
    try:
        return tuple(int(part) for part in version.split("."))
    except ValueError:
        return (0, 0, 0)


def human_size(num_bytes):
    if num_bytes >= 1024 ** 3:
        return f"{num_bytes / 1024 ** 3:.1f} GB"
    return f"{num_bytes / 1024 ** 2:.0f} MB"


def resolve_cert_paths(cfg):
    """Returns the 4 cert/key path strings (API + apps), using ONLY
    cluster.yaml's 'certificates' section — empty string when a field
    isn't set, no default fallback path. Deliberately not defaulted:
    an earlier version defaulted unset fields to ~/.ocplab/certs/<name>-*,
    which meant leftover files from the (now-removed) self-signed cert
    generator sat at that path and got silently re-applied by 'finalize'
    on a later deploy even though cluster.yaml never declared them again.
    Custom certs must now be explicit, not merely present on disk. Kept as
    raw (possibly '~'-prefixed) strings, same as
    credentials.pullSecretFile/sshPublicKeyFile — Ansible expands them
    with the '| expanduser' filter at the point of use, not here."""
    certs = dig(cfg, "certificates") or {}
    return {
        "api_cert_file": certs.get("apiCertFile") or "",
        "api_key_file": certs.get("apiKeyFile") or "",
        "apps_cert_file": certs.get("appsCertFile") or "",
        "apps_key_file": certs.get("appsKeyFile") or "",
    }


def tf_literal(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    return json.dumps(str(value))


