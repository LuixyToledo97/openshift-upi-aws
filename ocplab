    if args.minimal:
        flavour = "Minimal template"
        extra = (
            "\nIt trades capacity and resilience for cost: smaller instances, 100 GB disks,\n"
            "and Spot for the workers and bootstrap. Read the comments before deploying —\n"
            "notably, 'ocplab power off' does not work with Spot workers."
        )
    else:
