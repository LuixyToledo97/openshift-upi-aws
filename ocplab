def cmd_web(args):
    """Serve the local web UI.

    Kept to the same shape as `ssh`: this file resolves what to run and hands
    over, with no logic of its own. The server lives in web/server.py, is
    imported rather than embedded so `ocplab` stays a readable single file, and
    talks to the rest of the project only by running `ocplab` as a subprocess.
    """
    server_py = REPO_ROOT / "web" / "server.py"
    if not server_py.is_file():
        die(f"{server_py} is missing — the web UI is part of the repository, not a separate install.")

    import importlib.util
    spec = importlib.util.spec_from_file_location("ocplab_web_server", server_py)
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    except Exception as exc:  # noqa: BLE001 - surfaced to the user, not swallowed
        die(f"could not load the web server ({exc}).")
    module.serve(port=args.port, open_browser=not args.no_browser)


