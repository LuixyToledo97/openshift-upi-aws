def collect_status(cfg):
    """Everything `status` knows, as data rather than as printed lines.

    Split out so the web UI can render a dashboard without parsing human text.
    Everything in here is local and instant — no AWS call, no cluster call —
    which is what makes it safe to poll. Live state stays where it was:
    `verify` and `power status`.
    """
    version = dig(cfg, "openshift", "version")
    cached = cached_versions()
    shell_kubeconfig = os.environ.get("KUBECONFIG")

    data = {
        "cluster": {
            "name": cfg["metadata"]["name"],
            "base_domain": cfg["metadata"]["baseDomain"],
            "region": cfg["platform"]["aws"]["region"],
            "control_plane": cfg["controlPlane"]["replicas"],
            "compute": cfg["compute"]["replicas"],
        },
        "openshift": {
            "pinned": version,
            "downloaded": bool(version) and any(v["version"] == version for v in cached),
            "cache": [{"version": v["version"], "size": v["size"]} for v in cached],
            "cache_total": sum(v["size"] for v in cached),
            "cache_total_human": human_size(sum(v["size"] for v in cached)) if cached else None,
            "cache_dir": str(BIN_CACHE),
        },
        "kubeconfig": {
            "expected": str(KUBECONFIG_PATH),
            "current": shell_kubeconfig,
            "points_here": shell_kubeconfig == str(KUBECONFIG_PATH),
            "exists": KUBECONFIG_PATH.exists(),
        },
        "install_dir": {"exists": False},
        "terraform": {"exists": False},
    }

    meta_file = INSTALL_DIR / "metadata.json"
    if meta_file.exists():
        age_h = (time.time() - meta_file.stat().st_mtime) / 3600
        data["install_dir"] = {
            "exists": True,
            "infra_id": json.loads(meta_file.read_text()).get("infraID", "?"),
            "age_hours": round(age_h, 1),
            # The 24h expiry is the whole reason this is reported at all.
            "stale": age_h > OCPLAB_IGNITION_MAX_AGE_HOURS,
        }

    tfstate = TERRAFORM_DIR / "terraform.tfstate"
    if tfstate.exists():
        state = json.loads(tfstate.read_text())
        data["terraform"] = {"exists": True, "resources": len(state.get("resources", []))}

    return data


def cmd_status(args):
    cfg = load_and_validate(args.config)

    # Before reporting, not after: status used to describe a pinned version as
    # active while `oc` still resolved elsewhere, because nothing had relinked
    # .venv/bin yet. Reporting a state is a poor excuse for not applying it.
    sync_managed_binaries(cfg)

    data = collect_status(cfg)
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
        return

    c, o, k = data["cluster"], data["openshift"], data["kubeconfig"]
    print(f"cluster.yaml: {c['name']}.{c['base_domain']} ({c['region']})")

    if o["pinned"]:
        state = "downloaded" if o["downloaded"] else "NOT downloaded — run 'ocplab versions download'"
        print(f"OpenShift: {o['pinned']} pinned in cluster.yaml, {state}")
    else:
        print("OpenShift: no version pinned — using openshift-install/oc from the PATH")
    if o["cache"]:
        listed = ", ".join(v["version"] for v in o["cache"])
        print(f"binary cache: {listed} ({o['cache_total_human']} in {o['cache_dir']})")

    # The version behind `oc` is reported two lines up; where it points is the
    # half that can silently be another cluster, so it belongs here too.
    if k["points_here"]:
        print("KUBECONFIG: this cluster")
    elif k["current"]:
        print(f"KUBECONFIG: {k['current']} — NOT this cluster")
    else:
        print("KUBECONFIG: unset — oc uses ~/.kube/config, which is NOT this cluster")

    idir = data["install_dir"]
    if idir["exists"]:
        stale = " (>24h, regenerate before applying Terraform)" if idir["stale"] else ""
        print(f"install-dir: infraID={idir['infra_id']}, generated {idir['age_hours']:.1f}h ago{stale}")
    else:
        print("install-dir: doesn't exist yet (run 'ocplab ignition')")

    if data["terraform"]["exists"]:
        print(f"terraform.tfstate: {data['terraform']['resources']} managed resources")
    else:
        print("terraform.tfstate: doesn't exist yet (nothing deployed)")

    print("\nFor the cluster's live status (nodes, operators) use 'ocplab verify'.")
    print("For whether it's currently powered on or off use 'ocplab power status'.")


