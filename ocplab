def cmd_init(args):
    if args.config.exists() and not args.force:
        die(f"{args.config} already exists. Use --force to overwrite it.")
    args.config.write_text(CLUSTER_YAML_EXAMPLE)
    print(f"Template written to {args.config}. Edit it with real values and run 'ocplab validate'.")


def cmd_setup(args):
    venv_dir = REPO_ROOT / ".venv"
    pip = venv_dir / "bin" / "pip"
    ansible_galaxy = venv_dir / "bin" / "ansible-galaxy"

    try:
        if venv_dir.exists() and not args.recreate:
            print(f"The venv already exists at {venv_dir} (use --recreate to rebuild it from scratch).", flush=True)
        else:
            if venv_dir.exists():
                shutil.rmtree(venv_dir)
            print(f"Creating the venv at {venv_dir}...", flush=True)
            subprocess.run([sys.executable, "-m", "venv", str(venv_dir)], check=True)

        print("Installing Python dependencies (requirements.txt)...", flush=True)
        subprocess.run([str(pip), "install", "--quiet", "--upgrade", "pip"], check=True)
        subprocess.run(
            [str(pip), "install", "--quiet", "-r", str(REPO_ROOT / "requirements.txt")],
            check=True,
        )

        print("Installing Ansible collections (ansible/requirements.yml)...", flush=True)
        subprocess.run(
            [str(ansible_galaxy), "collection", "install", "-r", str(ANSIBLE_DIR / "requirements.yml")],
            check=True,
        )
    except (subprocess.CalledProcessError, OSError) as exc:
        die(f"failed installing the environment ({exc}). Check the output above.")

    print()
    print("Done. Before using commands that call Ansible (bootstrap, preflight, deploy...):")
    print("  source .venv/bin/activate")


def cmd_validate(args):
    cfg = load_cluster_config(args.config)
    errors = validate_cluster_config(cfg, args.config)
    if errors:
        print(f"{args.config}: {len(errors)} validation error(s):\n")
        for err in errors:
            print(f"  - {err}")
        sys.exit(1)
    name = cfg["metadata"]["name"]
    domain = cfg["metadata"]["baseDomain"]
    cp = cfg["controlPlane"]["replicas"]
    comp = cfg["compute"]["replicas"]
    region = cfg["platform"]["aws"]["region"]
    print(f"{args.config}: valid")
    print(f"  cluster:   {name}.{domain}")
    print(f"  region:    {region}")
    print(f"  topology:  {cp} control plane + {comp} compute")


def cmd_render(args):
    cfg = load_and_validate(args.config)

    cfg["openshift"] = cfg.get("openshift") or {}
    region = cfg["platform"]["aws"]["region"]
    if cfg["openshift"].get("rhcosAmi"):
        print(f"RHCOS AMI: {cfg['openshift']['rhcosAmi']} (from cluster.yaml)")
    else:
        ami = discover_rhcos_ami(region)
        cfg["openshift"]["rhcosAmi"] = ami
        print(f"RHCOS AMI: {ami} (auto-discovered for {region})")

    print(f"Generating files from {args.config}" + (" (dry-run)" if args.dry_run else "") + ":")
    write_generated_file(
        TERRAFORM_DIR / "terraform.tfvars",
        render_tfvars(cfg),
        dry_run=args.dry_run,
        verbosity=args.verbose,
    )
    write_generated_file(
        ANSIBLE_DIR / "inventory" / "group_vars" / "all" / "generated.yml",
        render_ansible_vars(cfg),
        dry_run=args.dry_run,
        verbosity=args.verbose,
    )


def cmd_bootstrap(args):
    # Was just 'load_and_validate' — bootstrap's role reads ocplab_base_domain/
    # ocplab_route53_public_zone_id/etc. from generated.yml, not from
    # args.config directly, so without a fresh render '-f <other-config>'
    # silently had no effect on which domain/zone it actually operated on
    # (found the hard way: it operated on stale/real values instead of a
    # disposable test config during a bootstrap-destroy test). Matches
    # cmd_deploy, which already renders first for the same reason.
    cmd_render(args)
    action = args.action
    confirm_msg = None
    if action == "apply":
        confirm_msg = (
            "This may create an IAM user with AdministratorAccess, generate a new "
            "access key in ~/.aws/credentials, and create the public Route53 hosted "
            "zone if any of it is missing. If it already exists, nothing is touched. Continue?"
        )
    elif action == "destroy":
        confirm_msg = (
            "This deletes the public Route53 hosted zone (cleaning up any leftover "
            "records first, e.g. a stray '*.apps' alias left behind by a prior "
            "cluster) and the local SSH keypair. Does NOT touch the IAM user. Continue?"
        )
        if args.delete_iam_user:
            confirm_msg = (
                "This ALSO deletes the IAM user currently configured as "
                "platform.aws.profile, using --admin-profile. If you have no other "
                "working AWS credentials, this locks you out of further 'ocplab' "
                "automation until you reconfigure --admin-profile by hand. " + confirm_msg
            )
    run_ansible_playbook(
        "bootstrap", args,
        extra_vars={
            "ocplab_bootstrap_action": action,
            "bootstrap_admin_profile": args.admin_profile,
            "bootstrap_delete_iam_user": args.delete_iam_user,
        },
        confirm_msg=confirm_msg,
    )


