# --------------------------------------------------------------------------
# argparse — global flags valid both before AND after the subcommand
# --------------------------------------------------------------------------

def add_global_args(parser, *, suppress_defaults):
    parser.add_argument(
        "-f", "--config", type=Path,
        default=(argparse.SUPPRESS if suppress_defaults else Path("cluster.yaml")),
        help="path to cluster.yaml (default: ./cluster.yaml)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        default=(argparse.SUPPRESS if suppress_defaults else False),
        help="don't write or change anything, just show what would happen",
    )
    parser.add_argument(
        "-v", "--verbose", action="count",
        default=(argparse.SUPPRESS if suppress_defaults else 0),
        help="increase output detail (repeatable: -vv)",
    )
    parser.add_argument(
        "--yes", action="store_true",
        default=(argparse.SUPPRESS if suppress_defaults else False),
        help="don't ask for confirmation on destructive operations",
    )
    parser.add_argument(
        "--tags", default=(argparse.SUPPRESS if suppress_defaults else None),
        help="Ansible tags to pass through to the underlying playbook",
    )


def build_parser():
    global_parser = argparse.ArgumentParser(add_help=False)
    add_global_args(global_parser, suppress_defaults=False)

    sub_global_parser = argparse.ArgumentParser(add_help=False)
    add_global_args(sub_global_parser, suppress_defaults=True)

    parser = argparse.ArgumentParser(
        prog="ocplab",
        description="CLI for the OpenShift UPI on AWS lab.",
        parents=[global_parser],
    )
    parser.add_argument("--version", action="version", version=f"ocplab {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    p = subparsers.add_parser(
        "prereqs", parents=[sub_global_parser],
        help="print the manual AWS/DNS/Red Hat prerequisites checklist (no cluster.yaml needed)",
    )
    p.set_defaults(func=cmd_prereqs)

    p = subparsers.add_parser("init", parents=[sub_global_parser], help="generate a cluster.yaml template")
    p.add_argument("--force", action="store_true", help="overwrite cluster.yaml if it already exists")
    p.set_defaults(func=cmd_init)

    p = subparsers.add_parser(
        "setup", parents=[sub_global_parser],
        help="create the project venv and install Ansible, collections, and Python deps",
    )
    p.add_argument("--recreate", action="store_true", help="delete the existing venv and rebuild it from scratch")
    p.set_defaults(func=cmd_setup)

    p = subparsers.add_parser("validate", parents=[sub_global_parser], help="validate cluster.yaml without touching anything")
    p.set_defaults(func=cmd_validate)

    p = subparsers.add_parser(
        "render", parents=[sub_global_parser],
        help="cluster.yaml -> terraform.tfvars + inventory/group_vars/all/generated.yml",
        description=(
            "Renders terraform.tfvars and inventory/group_vars/all/generated.yml from "
            "cluster.yaml. You don't need to run this by hand before 'deploy'/'bootstrap'/"
            "'certs' — they all call it themselves as their first step, always, so the "
            "generated files are guaranteed fresh whenever those run. Run it standalone "
            "mainly to preview what a cluster.yaml edit would change, with --dry-run -v "
            "(shows a diff, touches nothing) — no venv needed for this one, only PyYAML. "
            "The generated files are always fully overwritten, never merged, so there's "
            "never anything to delete/clean up first. If a change needs to reach an "
            "ALREADY-DEPLOYED cluster (e.g. compute.replicas), rendering updates the file "
            "but you still need 'terraform apply' afterwards for it to take effect."
        ),
    )
    p.set_defaults(func=cmd_render)

    p = subparsers.add_parser(
        "bootstrap", parents=[sub_global_parser],
        help="manage the AWS prerequisites: IAM user, public hosted zone, SSH key",
    )
    p.add_argument(
        "action", nargs="?", default="apply", choices=["apply", "status", "destroy"],
        help="apply (default): create/ensure. status: read-only check. destroy: tear down.",
    )
    p.add_argument(
        "--admin-profile", default="default",
        help="already-authenticated AWS profile, used to create/delete the IAM user (default: 'default')",
    )
    p.add_argument(
        "--delete-iam-user", action="store_true",
        help="with 'destroy': ALSO delete the IAM user (locks you out without another working AWS profile)",
    )
    p.set_defaults(func=cmd_bootstrap)

    p = subparsers.add_parser("preflight", parents=[sub_global_parser], help="pre-flight checks (binaries, credentials, DNS, quotas)")
    p.set_defaults(func=cmd_preflight)

    p = subparsers.add_parser("ignition", parents=[sub_global_parser], help="generate/regenerate install-dir and the Ignition configs")
    p.add_argument("--force", action="store_true", help="regenerate even if install-dir is less than 24h old")
    p.set_defaults(func=cmd_ignition)

    p = subparsers.add_parser("deploy", parents=[sub_global_parser], help="render + ignition + apply + cluster boot + finalize")
    p.set_defaults(func=cmd_deploy)

    p = subparsers.add_parser("verify", parents=[sub_global_parser], help="check the health of the deployed cluster")
    p.set_defaults(func=cmd_verify)

    p = subparsers.add_parser("cost", parents=[sub_global_parser], help="approximate current USD/hour cost of what's deployed")
    p.set_defaults(func=cmd_cost)

    p = subparsers.add_parser("status", parents=[sub_global_parser], help="local status summary (without touching AWS)")
    p.set_defaults(func=cmd_status)

    p = subparsers.add_parser("destroy", parents=[sub_global_parser], help="ordered teardown of the cluster")
    p.set_defaults(func=cmd_destroy)

    p = subparsers.add_parser(
        "power", parents=[sub_global_parser],
        help="gracefully power the cluster on/off (or check which it is), as an alternative to destroy",
    )
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_power)

    p = subparsers.add_parser("safety-net", parents=[sub_global_parser], help="manage the budget/killswitch outside of Terraform")
    p.add_argument("action", choices=["apply", "status", "destroy"])
    p.set_defaults(func=cmd_safety_net)

    p = subparsers.add_parser("console", parents=[sub_global_parser], help="print the console URL and the kubeadmin password")
    p.set_defaults(func=cmd_console)

    return parser


def main(argv=None):
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        die(
            "don't run ocplab as root or with sudo. It doesn't need it — it uses "
            "your own AWS credentials (~/.aws) and your own local files "
            "(~/.ocplab, ~/.ssh). As root it looks for those files under /root and fails."
        )
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except ConfigError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)


if __name__ == "__main__":
    main()
