def cmd_setup(args):
    venv_dir = REPO_ROOT / ".venv"
    pip = venv_dir / "bin" / "pip"
    ansible_galaxy = venv_dir / "bin" / "ansible-galaxy"

    try:
        if venv_dir.exists() and not args.recreate:
            print(f"The venv already exists at {venv_dir} (use --recreate to rebuild it from scratch).", flush=True)
        else:
            if venv_dir.exists():
                shutil.rmtree(venv_dir)
            print(f"Creating the venv at {venv_dir}...", flush=True)
            subprocess.run([sys.executable, "-m", "venv", str(venv_dir)], check=True)

        print("Installing Python dependencies (requirements.txt)...", flush=True)
        subprocess.run([str(pip), "install", "--quiet", "--upgrade", "pip"], check=True)
        subprocess.run(
            [str(pip), "install", "--quiet", "-r", str(REPO_ROOT / "requirements.txt")],
            check=True,
        )

        print("Installing Ansible collections (ansible/requirements.yml)...", flush=True)
        subprocess.run(
            [str(ansible_galaxy), "collection", "install", "-r", str(ANSIBLE_DIR / "requirements.yml")],
            check=True,
        )
    except (subprocess.CalledProcessError, OSError) as exc:
        die(f"failed installing the environment ({exc}). Check the output above.")

    install_kubeconfig_hook()

    print()
    print("Done. Before using commands that call Ansible (bootstrap, preflight, deploy...):")
    print("  source .venv/bin/activate")
    print()
    print("That also points oc/kubectl at this cluster (KUBECONFIG), unless you've set")
    print("KUBECONFIG yourself, and undoes it on 'deactivate'.")


def cmd_validate(args):
    cfg = load_cluster_config(args.config)
    errors = validate_cluster_config(cfg, args.config)
    if errors:
        print(f"{args.config}: {len(errors)} validation error(s):\n")
        for err in errors:
            print(f"  - {err}")
        sys.exit(1)
    name = cfg["metadata"]["name"]
    domain = cfg["metadata"]["baseDomain"]
    cp = cfg["controlPlane"]["replicas"]
    comp = cfg["compute"]["replicas"]
    region = cfg["platform"]["aws"]["region"]
    print(f"{args.config}: valid")
    print(f"  cluster:   {name}.{domain}")
    print(f"  region:    {region}")
    print(f"  topology:  {cp} control plane + {comp} compute")


def cmd_render(args, *, zone_id_optional=False, honor_dry_run=True):
    """honor_dry_run=False is what makes --dry-run truthful for other commands.

    When the user runs `ocplab render --dry-run`, the generated files ARE the
    subject of the command, so --dry-run means "show the diff, write nothing" —
    that's the documented way to preview a cluster.yaml edit, and it stays.

    When another command renders on its way to running a playbook, those files
    are plumbing rather than the subject: the roles read `generated.yml`, so
    skipping the write would leave the dry-run inspecting whatever the last
    render happened to leave behind — answering confidently about a config the
    user no longer has. They're gitignored, deterministic, and rebuilt from
    cluster.yaml in under a second, so regenerating them is not the kind of
    change --dry-run exists to prevent.
    """
    cfg = load_and_validate(args.config, zone_id_optional=zone_id_optional)

    cfg["openshift"] = cfg.get("openshift") or {}
    region = cfg["platform"]["aws"]["region"]
    version = cfg["openshift"].get("version")
    installer = resolve_binaries(cfg)["openshift-install"]

    if version and not Path(installer).exists():
        die(
            f"OpenShift {version} is declared in cluster.yaml but isn't downloaded yet.\n"
            f"  Get it with:  ocplab versions download {version}\n"
            f"  Or see what's available:  ocplab versions list"
        )

    if cfg["openshift"].get("rhcosAmi"):
        pinned = cfg["openshift"]["rhcosAmi"]
        # flush: the warning below goes to stderr, which is unbuffered. Without
        # this, piping or redirecting puts the warning *above* the line it is
        # commenting on, which reads as a warning about something else.
        print(f"RHCOS AMI: {pinned} (from cluster.yaml)", flush=True)
        # Pinning both the version and the AMI lets them disagree, and nothing
        # downstream notices: the nodes would boot an RHCOS that doesn't match
        # the OpenShift release, which surfaces much later as odd boot failures
        # rather than as a configuration error. Checking costs nothing — the
        # installer carries the image catalogue internally, no network or AWS
        # call. A warning rather than an error, because pinning a specific
        # image can be deliberate (a custom build, a deliberate downgrade).
        try:
            expected = discover_rhcos_ami(region, installer)
        except ConfigError:
            expected = None  # no installer to ask; the explicit AMI still stands
        if expected and expected != pinned:
            print(
                f"warning: openshift.rhcosAmi is {pinned}, but openshift-install "
                f"{version or 'on the PATH'} expects {expected} for {region}. "
                "Remove openshift.rhcosAmi to keep the image tied to the version.",
                file=sys.stderr,
            )
    else:
        ami = discover_rhcos_ami(region, installer)
        cfg["openshift"]["rhcosAmi"] = ami
        source = f"openshift-install {version}" if version else "openshift-install on the PATH"
        print(f"RHCOS AMI: {ami} (auto-discovered for {region}, from {source})")

    # Only when the files are really being written: under `render --dry-run`
    # nothing should change on disk, and a symlink is on disk.
    # Symmetry matters here. Unpinning the version has to actually put you back
    # on the PATH binaries — leaving yesterday's links behind would keep
    # silently serving a managed version cluster.yaml no longer mentions.
    if not dry_run_for(args, honor_dry_run):
        sync_managed_binaries(cfg)

    dry_run = dry_run_for(args, honor_dry_run)
    if not args.dry_run:
        note = ""
    elif dry_run:
        note = " (dry-run)"
    else:
        note = " (regenerated so this dry-run reflects cluster.yaml)"
    print(f"Generating files from {args.config}{note}:")
    write_generated_file(
        TERRAFORM_DIR / "terraform.tfvars",
        render_tfvars(cfg),
        dry_run=dry_run,
        verbosity=args.verbose,
    )
    write_generated_file(
        ANSIBLE_DIR / "inventory" / "group_vars" / "all" / "generated.yml",
        render_ansible_vars(cfg),
        dry_run=dry_run,
        verbosity=args.verbose,
    )


