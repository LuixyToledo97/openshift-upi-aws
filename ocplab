# --------------------------------------------------------------------------
# ssh: the one command whose logic is NOT in an Ansible role.
#
# CLAUDE.md's rule is that ocplab stays a thin CLI and every bit of logic lives
# in a role. This is a deliberate, single exception, because an interactive
# shell cannot: an Ansible module never hands over the terminal, so a task
# can't give you a session. The exception is narrow on purpose — there is no
# AWS logic here beyond resolving a name to an instance ID, and the process is
# then replaced by ssh itself (execvp, not a subprocess), so ocplab is out of
# the way entirely for the duration of the session.
# --------------------------------------------------------------------------

# RHCOS's default (and only) login user.
SSH_USER = "core"


def aws_cli_json(cfg, *cli_args):
    """Run an aws CLI command with the lab's profile/region and parse its JSON."""
    aws = cfg["platform"]["aws"]
    cmd = ["aws", *cli_args, "--profile", aws["profile"], "--region", aws["region"], "--output", "json"]
    label = " ".join(cli_args[:2])
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=60)
    except FileNotFoundError:
        die("'aws' not found on the PATH — see README section 2.1.")
    except subprocess.TimeoutExpired:
        die(f"'aws {label}' timed out after 60s. Check your network and credentials.")
    except subprocess.CalledProcessError as exc:
        die(f"'aws {label}' failed: {(exc.stderr or '').strip()}")
    try:
        return json.loads(result.stdout)
    except ValueError:
        die(f"could not parse the output of 'aws {label}'.")


def discover_nodes(cfg):
    """The cluster's running nodes, as (short name, instance id, private DNS).

    Matched on the Name tag Terraform already sets — "<cluster>-master-0",
    "<cluster>-worker-1" (ec2.tf uses count.index) — so the short names the
    user types are the ones the infrastructure already uses, not a second
    naming scheme invented here.
    """
    prefix = f"{cfg['metadata']['name']}-"
    payload = aws_cli_json(
        cfg, "ec2", "describe-instances",
        "--filters",
        f"Name=tag:Name,Values={prefix}master-*,{prefix}worker-*",
        "Name=instance-state-name,Values=running",
    )
    nodes = []
    for reservation in payload.get("Reservations", []):
        for instance in reservation.get("Instances", []):
            name = next(
                (t["Value"] for t in instance.get("Tags", []) if t["Key"] == "Name"), ""
            )
            nodes.append({
                "name": name[len(prefix):] if name.startswith(prefix) else name,
                "id": instance.get("InstanceId", ""),
                "dns": instance.get("PrivateDnsName", ""),
                "state": instance.get("State", {}).get("Name", ""),
            })
    # master-0 before master-1 before worker-0: role first, then index, so the
    # listing order matches how someone thinks about the cluster.
    return sorted(nodes, key=lambda n: n["name"])


def ssh_private_key(cfg):
    """Same derivation the bootstrap role uses: the public key path minus '.pub'."""
    public = cfg["credentials"]["sshPublicKeyFile"]
    private = Path(public[:-4] if public.endswith(".pub") else public).expanduser()
    if not private.exists():
        die(
            f"no SSH private key at {private} (derived from "
            f"credentials.sshPublicKeyFile). Run 'ocplab bootstrap apply' to create "
            "the keypair, or point cluster.yaml at an existing one."
        )
    return private


def cmd_ssh(args):
    cfg = load_and_validate(args.config)
    nodes = discover_nodes(cfg)

    if not nodes:
        die(
            f"no running nodes found for cluster '{cfg['metadata']['name']}'. "
            "Nothing deployed? Check 'ocplab status' or 'ocplab power status'."
        )

    if not args.node:
        width = max(len(n["name"]) for n in nodes)
        print(f"{'NODE'.ljust(width)}  {'INSTANCE':<21} PRIVATE DNS")
        for node in nodes:
            print(f"{node['name'].ljust(width)}  {node['id']:<21} {node['dns']}")
        print(f"\nConnect with: ocplab ssh {nodes[0]['name']}")
        return

    match = next((n for n in nodes if n["name"] == args.node), None)
    if match is None:
        die(
            f"no running node called '{args.node}'. Available: "
            + ", ".join(n["name"] for n in nodes)
        )

    key = ssh_private_key(cfg)
    aws = cfg["platform"]["aws"]
    # The tunnel is an authenticated TCP proxy, so ssh talks to the instance ID
    # as if it were a hostname and %h passes it straight through.
    proxy = (
        f"aws ec2-instance-connect open-tunnel --instance-id %h "
        f"--profile {aws['profile']} --region {aws['region']}"
    )
    # Host keys go in their own file: instance IDs are unique per instance and
    # this lab recreates its nodes constantly, so the user's real known_hosts
    # would otherwise fill with entries that can never match again. Kept rather
    # than discarded so a key changing under the same instance ID — which
    # should never happen — is still noticed.
    known_hosts = Path("~/.ocplab/known_hosts").expanduser()
    known_hosts.parent.mkdir(parents=True, exist_ok=True)

    cmd = [
        "ssh",
        "-i", str(key),
        "-o", f"ProxyCommand={proxy}",
        "-o", f"UserKnownHostsFile={known_hosts}",
        "-o", "StrictHostKeyChecking=accept-new",
        f"{SSH_USER}@{match['id']}",
        *args.ssh_args,
    ]
    print(f"Connecting to {args.node} ({match['id']}) via EC2 Instance Connect Endpoint...")
    try:
        # execvp, not subprocess: ocplab has nothing left to do, and replacing
        # the process keeps the TTY, signal handling and exit status exactly as
        # a plain ssh would — no wrapper in the middle of an interactive session.
        os.execvp("ssh", cmd)
    except OSError as exc:
        die(f"couldn't run 'ssh' ({exc.strerror}).")


def cmd_versions(args):
    # zone_id_optional: 'versions list' is how you find out what to write in
    # cluster.yaml, so it has to work on a config that's still being filled in —
    # same reasoning as bootstrap, which creates the zone whose ID is missing.
    cfg = load_and_validate(args.config, zone_id_optional=True)
    declared = dig(cfg, "openshift", "version") or ""

    target = args.version
    if args.action == "download" and not target:
        # No argument means "whatever cluster.yaml declares", which is the
        # common case: pin the version, then fetch it.
        target = declared
        if not target:
            die(
                "'ocplab versions download' needs a version, or an 'openshift.version' "
                "in cluster.yaml to take one from. Run 'ocplab versions list' to see "
                "what's available."
            )
    rc = run_ansible_playbook(
        "versions", args,
        extra_vars={
            "ocplab_versions_action": args.action,
            "ocplab_versions_target": target or "",
            "ocplab_versions_refresh": args.refresh,
            # Passed directly rather than through generated.yml: this command
            # deliberately doesn't render (see run_ansible_playbook), because
            # rendering needs the very binary you may be about to download.
            "ocplab_openshift_version": declared,
        },
        zone_id_optional=True,
        render=False,
        exit_after=False,
    )
    # After, not before: a download only becomes linkable once it exists.
    sync_managed_binaries(cfg)
    sys.exit(rc)


