# --------------------------------------------------------------------------
# argparse — global flags valid both before AND after the subcommand
# --------------------------------------------------------------------------

def add_global_args(parser, *, suppress_defaults):
    parser.add_argument(
        "-f", "--config", type=Path,
        default=(argparse.SUPPRESS if suppress_defaults else Path("cluster.yaml")),
        help="path to cluster.yaml (default: ./cluster.yaml)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        default=(argparse.SUPPRESS if suppress_defaults else False),
        help=(
            "don't change anything in AWS or in the cluster, just show what would "
            "happen (the generated files are still refreshed from cluster.yaml, so "
            "the preview reflects your current config; 'ocplab render --dry-run' "
            "writes nothing at all)"
        ),
    )
    parser.add_argument(
        "-v", "--verbose", action="count",
        default=(argparse.SUPPRESS if suppress_defaults else 0),
        help="increase output detail (repeatable: -vv)",
    )
    parser.add_argument(
        "--yes", action="store_true",
        default=(argparse.SUPPRESS if suppress_defaults else False),
        help="don't ask for confirmation on destructive operations",
    )
    parser.add_argument(
        "--tags", default=(argparse.SUPPRESS if suppress_defaults else None),
        help="Ansible tags to pass through to the underlying playbook",
    )


def build_parser():
    global_parser = argparse.ArgumentParser(add_help=False)
    add_global_args(global_parser, suppress_defaults=False)

    sub_global_parser = argparse.ArgumentParser(add_help=False)
    add_global_args(sub_global_parser, suppress_defaults=True)

    parser = argparse.ArgumentParser(
        prog="ocplab",
        description="CLI for the OpenShift UPI on AWS lab.",
        parents=[global_parser],
    )
    parser.add_argument("--version", action="version", version=f"ocplab {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    p = subparsers.add_parser(
        "prereqs", parents=[sub_global_parser],
        help="print the manual AWS/DNS/Red Hat prerequisites checklist (no cluster.yaml needed)",
    )
    p.set_defaults(func=cmd_prereqs)

    p = subparsers.add_parser(
        "init", parents=[sub_global_parser], help="generate a cluster.yaml template",
        description=(
            "Writes a starter cluster.yaml. The default is the standard profile. "
            "--minimal writes the cheaper one instead (examples/minimal.yaml): Red Hat's "
            "documented minimum instance sizes, 100 GB disks, and Spot for the workers "
            "and bootstrap — roughly $0.83/h against $1.06/h, at the cost of AWS being "
            "able to reclaim the workers and of 'ocplab power off' no longer working."
        ),
    )
    p.add_argument("--force", action="store_true", help="overwrite cluster.yaml if it already exists")
    p.add_argument("--minimal", action="store_true", help="write the cheaper profile instead of the standard one")
    p.set_defaults(func=cmd_init)

    p = subparsers.add_parser(
        "setup", parents=[sub_global_parser],
        help="create the project venv and install Ansible, collections, and Python deps",
    )
    p.add_argument("--recreate", action="store_true", help="delete the existing venv and rebuild it from scratch")
    p.set_defaults(func=cmd_setup)

    p = subparsers.add_parser("validate", parents=[sub_global_parser], help="validate cluster.yaml without touching anything")
    p.set_defaults(func=cmd_validate)

    p = subparsers.add_parser(
        "render", parents=[sub_global_parser],
        help="cluster.yaml -> terraform.tfvars + inventory/group_vars/all/generated.yml",
        description=(
            "Renders terraform.tfvars and inventory/group_vars/all/generated.yml from "
            "cluster.yaml. You don't need to run this by hand before 'deploy'/'bootstrap'/"
            "'certs' — they all call it themselves as their first step, always, so the "
            "generated files are guaranteed fresh whenever those run. Run it standalone "
            "mainly to preview what a cluster.yaml edit would change, with --dry-run -v "
            "(shows a diff, touches nothing) — no venv needed for this one, only PyYAML. "
            "The generated files are always fully overwritten, never merged, so there's "
            "never anything to delete/clean up first. If a change needs to reach an "
            "ALREADY-DEPLOYED cluster (e.g. compute.replicas), rendering updates the file "
            "but you still need 'terraform apply' afterwards for it to take effect."
        ),
    )
    p.set_defaults(func=cmd_render)

    p = subparsers.add_parser(
        "bootstrap", parents=[sub_global_parser],
        help="manage the AWS prerequisites: IAM user, public hosted zone, SSH key",
    )
    p.add_argument(
        "action", nargs="?", default="apply", choices=["apply", "status", "destroy"],
        help="apply (default): create/ensure. status: read-only check. destroy: tear down.",
    )
    p.add_argument(
        "--admin-profile", default="default",
        help="already-authenticated AWS profile, used to create/delete the IAM user (default: 'default')",
    )
    p.add_argument(
        "--delete-iam-user", action="store_true",
        help="with 'destroy': ALSO delete the IAM user (locks you out without another working AWS profile)",
    )
    p.set_defaults(func=cmd_bootstrap)

    p = subparsers.add_parser("preflight", parents=[sub_global_parser], help="pre-flight checks (binaries, credentials, DNS, quotas)")
    p.set_defaults(func=cmd_preflight)

    p = subparsers.add_parser("ignition", parents=[sub_global_parser], help="generate/regenerate install-dir and the Ignition configs")
    p.add_argument("--force", action="store_true", help="regenerate even if install-dir is less than 24h old")
    p.set_defaults(func=cmd_ignition)

    p = subparsers.add_parser("deploy", parents=[sub_global_parser], help="render + ignition + apply + cluster boot + finalize")
    p.set_defaults(func=cmd_deploy)

    p = subparsers.add_parser("verify", parents=[sub_global_parser], help="check the health of the deployed cluster")
    p.set_defaults(func=cmd_verify)

    p = subparsers.add_parser("cost", parents=[sub_global_parser], help="approximate current USD/hour cost of what's deployed")
    p.set_defaults(func=cmd_cost)

    p = subparsers.add_parser("status", parents=[sub_global_parser], help="local status summary (without touching AWS)")
    p.add_argument("--json", action="store_true", help="emit the same information as JSON")
    p.set_defaults(func=cmd_status)

    p = subparsers.add_parser("destroy", parents=[sub_global_parser], help="ordered teardown of the cluster")
    p.set_defaults(func=cmd_destroy)

    p = subparsers.add_parser(
        "power", parents=[sub_global_parser],
        help="gracefully power the cluster on/off (or check which it is), as an alternative to destroy",
    )
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_power)

    p = subparsers.add_parser("safety-net", parents=[sub_global_parser], help="manage the budget/killswitch outside of Terraform")
    p.add_argument("action", choices=["apply", "status", "destroy"])
    p.set_defaults(func=cmd_safety_net)

    p = subparsers.add_parser("console", parents=[sub_global_parser], help="print the console URL and the kubeadmin password")
    p.set_defaults(func=cmd_console)

    p = subparsers.add_parser(
        "web", parents=[sub_global_parser],
        help="serve the local web UI on 127.0.0.1",
        description=(
            "Serves a browser UI for this lab: the dashboard, the cluster.yaml "
            "editor, and every operation with its output streamed live.\n\n"
            "It binds 127.0.0.1 and nothing else, rejects requests whose Host "
            "header is not loopback, and requires a token minted at startup — "
            "this server holds your AWS credentials and can create and destroy "
            "real infrastructure, so it is not something to expose. There is "
            "deliberately no flag to change the bind address.\n\n"
            "'ocplab ssh' is not available in the browser: it needs a real "
            "terminal. Run it from a shell."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--port", type=int, default=8770, help="port on 127.0.0.1 (default: 8770)")
    p.add_argument("--no-browser", action="store_true", help="don't open a browser window")
    p.set_defaults(func=cmd_web)

    p = subparsers.add_parser(
        "env", parents=[sub_global_parser],
        help="print the shell settings for this cluster (use with eval)",
        description=(
            "Prints 'export KUBECONFIG=...' for this cluster, so oc and kubectl talk "
            "to it instead of whatever context ~/.kube/config currently has:\n\n"
            "  eval \"$(ocplab env)\"\n\n"
            "'ocplab setup' already does this for you whenever you activate the venv; "
            "this command is for the shells that hook cannot reach — one where the "
            "venv was never activated, a script, or a venv created before the hook "
            "existed. Nothing but the export goes to stdout, so it is always safe to "
            "eval."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.set_defaults(func=cmd_env)

    p = subparsers.add_parser(
        "repair", parents=[sub_global_parser],
        help="recreate a worker that disappeared, on an otherwise healthy cluster",
        description=(
            "Recreates workers that Terraform manages but that no longer exist, "
            "approves the new node's CSRs, and removes Node objects left behind by "
            "instances that are gone. The usual cause is AWS reclaiming a Spot "
            "instance (compute.spot), but nothing here is Spot-specific — a node "
            "terminated by hand, or lost to an AWS failure, is recovered the same "
            "way. It deliberately never regenerates install-dir, since that would "
            "change the infraID and break the running cluster, and it refuses to "
            "apply any plan that would change or destroy anything, or that touches "
            "a master: a replacement master needs its etcd membership repaired by "
            "hand, which this cannot do."
        ),
    )
    p.set_defaults(func=cmd_repair)

    p = subparsers.add_parser(
        "versions", parents=[sub_global_parser],
        help="list, download or remove the cached OpenShift binaries",
        description=(
            "Manages the openshift-install/oc binaries under ~/.ocplab/bin, one "
            "directory per version. 'list' shows what the mirror publishes and what "
            "you already have; 'download' fetches a version (checksum-verified, ~476 MB, "
            "cached afterwards); 'rm' removes one. Pin the version you want with "
            "'openshift.version' in cluster.yaml — leave it unset and ocplab keeps "
            "using whatever openshift-install and oc are on your PATH."
        ),
    )
    p.add_argument("action", choices=["list", "download", "rm"])
    p.add_argument("version", nargs="?", help="e.g. 4.22.6 (download takes it from cluster.yaml if omitted)")
    p.add_argument("--refresh", action="store_true", help="with 'list': re-read the mirror instead of the cached listing")
    p.set_defaults(func=cmd_versions)

    p = subparsers.add_parser(
        "ssh", parents=[sub_global_parser],
        help="list the cluster's nodes, or open a shell on one of them",
        description=(
            "With no argument, lists the running nodes by the short names Terraform "
            "already gives them (master-0, worker-1...). With a node name, opens an "
            "interactive shell on it. The nodes have no public IP and sit in the "
            "private subnet, so the connection goes through the EC2 Instance Connect "
            "Endpoint created with the rest of the infrastructure — an IAM-authorized "
            "TCP tunnel, no bastion and no public address. Anything after the node "
            "name is passed to ssh, so 'ocplab ssh master-0 sudo crictl ps' works."
        ),
    )
    p.add_argument("node", nargs="?", help="node to connect to, e.g. master-0 (omit to list)")
    p.add_argument("ssh_args", nargs=argparse.REMAINDER, help="command and arguments to pass to ssh")
    p.set_defaults(func=cmd_ssh)

    return parser


def main(argv=None):
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        die(
            "don't run ocplab as root or with sudo. It doesn't need it — it uses "
            "your own AWS credentials (~/.aws) and your own local files "
            "(~/.ocplab, ~/.ssh). As root it looks for those files under /root and fails."
        )
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except ConfigError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)


if __name__ == "__main__":
    main()
