def cmd_status(args):
    cfg = load_and_validate(args.config)
    name = cfg["metadata"]["name"]
    print(f"cluster.yaml: {name}.{cfg['metadata']['baseDomain']} ({cfg['platform']['aws']['region']})")

    meta_file = INSTALL_DIR / "metadata.json"
    if meta_file.exists():
        infra_id = json.loads(meta_file.read_text()).get("infraID", "?")
        age_h = (time.time() - meta_file.stat().st_mtime) / 3600
        stale = " (>24h, regenerate before applying Terraform)" if age_h > 24 else ""
        print(f"install-dir: infraID={infra_id}, generated {age_h:.1f}h ago{stale}")
    else:
        print("install-dir: doesn't exist yet (run 'ocplab ignition')")

    tfstate = TERRAFORM_DIR / "terraform.tfstate"
    if tfstate.exists():
        state = json.loads(tfstate.read_text())
        n = len(state.get("resources", []))
        print(f"terraform.tfstate: {n} managed resources")
    else:
        print("terraform.tfstate: doesn't exist yet (nothing deployed)")

    print("\nFor the cluster's live status (nodes, operators) use 'ocplab verify'.")
    print("For whether it's currently powered on or off use 'ocplab power status'.")


