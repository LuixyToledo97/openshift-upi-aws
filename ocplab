    creds = cfg["credentials"]
    safety = cfg.get("safetyNet") or {}
    killswitch = safety.get("killswitch") or {}
    cert_paths = resolve_cert_paths(cfg)

    data = {
        "ocplab_cluster_name": cfg["metadata"]["name"],
        "ocplab_base_domain": cfg["metadata"]["baseDomain"],
        "ocplab_aws_region": cfg["platform"]["aws"]["region"],
        "ocplab_aws_availability_zone": cfg["platform"]["aws"]["availabilityZone"],
        "ocplab_aws_profile": cfg["platform"]["aws"]["profile"],
        "ocplab_route53_public_zone_id": cfg["platform"]["aws"]["publicHostedZoneId"],
        "ocplab_vpc_cidr": cfg["networking"]["vpcCidr"],
        "ocplab_public_subnet_cidr": cfg["networking"]["publicSubnetCidr"],
        "ocplab_private_subnet_cidr": cfg["networking"]["privateSubnetCidr"],
        "ocplab_cluster_network_cidr": cfg["networking"]["clusterNetwork"],
        "ocplab_service_network_cidr": cfg["networking"]["serviceNetwork"],
        "ocplab_control_plane_replicas": cfg["controlPlane"]["replicas"],
        "ocplab_control_plane_instance_type": cfg["controlPlane"]["instanceType"],
        "ocplab_control_plane_volume_size": cfg["controlPlane"].get("volumeSize", 120),
        "ocplab_control_plane_volume_type": cfg["controlPlane"].get("volumeType", "gp3"),
        "ocplab_compute_replicas": cfg["compute"]["replicas"],
        "ocplab_compute_instance_type": cfg["compute"]["instanceType"],
        "ocplab_compute_volume_size": cfg["compute"].get("volumeSize", 120),
        "ocplab_compute_volume_type": cfg["compute"].get("volumeType", "gp3"),
        "ocplab_bootstrap_instance_type": cfg["bootstrap"]["instanceType"],
        "ocplab_bootstrap_volume_size": cfg["bootstrap"].get("volumeSize", 120),
        "ocplab_bootstrap_volume_type": cfg["bootstrap"].get("volumeType", "gp3"),
        "ocplab_rhcos_ami": dig(cfg, "openshift", "rhcosAmi"),
        "ocplab_pull_secret_file": creds["pullSecretFile"],
        "ocplab_ssh_public_key_file": creds["sshPublicKeyFile"],
        "ocplab_api_cert_file": cert_paths["api_cert_file"],
        "ocplab_api_key_file": cert_paths["api_key_file"],
        "ocplab_apps_cert_file": cert_paths["apps_cert_file"],
        "ocplab_apps_key_file": cert_paths["apps_key_file"],
        "ocplab_safety_net_enabled": bool(safety.get("enabled", False)),
        "ocplab_safety_net_budget_usd": safety.get("budgetUsd"),
        "ocplab_safety_net_alert_emails": safety.get("alertEmails", []),
        "ocplab_safety_net_killswitch_enabled": bool(killswitch.get("enabled", False)),
        "ocplab_safety_net_killswitch_schedule": killswitch.get("schedule"),
        "ocplab_safety_net_killswitch_timezone": killswitch.get("timezone"),
    }
    body = yaml.safe_dump(data, sort_keys=False, default_flow_style=False, allow_unicode=True)
    return GENERATED_HEADER + "\n" + body


def write_generated_file(path, content, *, dry_run, verbosity):
    rel = path.relative_to(REPO_ROOT)
    existing = path.read_text() if path.exists() else None
    if existing == content:
        print(f"  = {rel} (no changes)")
        return
    verb = "would write" if dry_run else "written"
    print(f"  * {rel} ({verb})")
    if verbosity and existing is not None:
        diff = difflib.unified_diff(
            existing.splitlines(True), content.splitlines(True),
            fromfile=f"a/{rel}", tofile=f"b/{rel}",
        )
        sys.stdout.writelines(diff)
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)


# --------------------------------------------------------------------------
# Ansible invocation (for commands whose logic lives in a playbook:
# bootstrap, preflight, ignition, deploy, verify, destroy, safety-net)
# --------------------------------------------------------------------------

def run_ansible_playbook(playbook_name, args, *, extra_vars=None, confirm_msg=None):
    playbook = PLAYBOOKS_DIR / f"{playbook_name}.yml"
    if not playbook.exists():
        die(
            f"'ansible/playbooks/{playbook_name}.yml' doesn't exist yet. "
            "This command is on the roadmap but not implemented yet "
            "— see the checklist in CLAUDE.md.",
            code=2,
        )

    if confirm_msg and not args.yes:
        resp = input(f"{confirm_msg} [y/N] ").strip().lower()
        if resp not in ("y", "yes"):
            print("Cancelled.")
            sys.exit(0)

    cmd = ["ansible-playbook", str(playbook)]
    if args.tags:
        cmd += ["--tags", args.tags]
    if args.dry_run:
        cmd += ["--check", "--diff"]
    if args.verbose:
        cmd.append("-" + "v" * args.verbose)

    ev = {"ocplab_config_path": str(args.config.resolve())}
    if extra_vars:
        ev.update(extra_vars)
    cmd += ["--extra-vars", json.dumps(ev)]

    try:
        result = subprocess.run(cmd, cwd=ANSIBLE_DIR)
    except OSError as exc:
        die(
            f"couldn't run 'ansible-playbook' ({exc.strerror}). "
            "Activate the project venv with 'source .venv/bin/activate' — that puts "
            "the right ansible-playbook first on the PATH, ahead of "
            "any other one that might be around (e.g. from another project or an "
            "editor extension). If it's already activated, check "
            "'which -a ansible-playbook' to see what's resolving first."
        )
    sys.exit(result.returncode)


